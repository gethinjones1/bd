# a configured vault that has gone missing is recreated on dump
env BD_NOW=2026-10-10T14:32:00Z
env XDG_CONFIG_HOME=$WORK/cfg
mkdir notes
exec bd config set vault $WORK/notes
rm notes
exec bd hello
stdout 'created vault .*notes'
grep hello notes/Daily/2026-10-10.md

# an existing vault is not announced
exec bd again
! stdout 'created vault'

# BD_VAULT and --vault are created too
env BD_VAULT=$WORK/fromenv
exec bd from env
exists fromenv/Daily/2026-10-10.md
exec bd --vault $WORK/fromflag/deep from flag
exists fromflag/deep/Daily/2026-10-10.md

# a path that is a file is still refused
! exec bd --vault $WORK/afile.md nope
stderr 'not a directory'

-- afile.md --
x
