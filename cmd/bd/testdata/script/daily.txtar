# BD_NOW pins the clock so daily note names are deterministic
env BD_NOW=2026-10-10T14:32:00Z
env XDG_CONFIG_HOME=$WORK/cfg
mkdir vault

# arg input creates today's daily note
exec bd --vault $WORK/vault --daily kafka retries need backoff
stdout 'Daily/2026-10-10.md'
cmp vault/Daily/2026-10-10.md want-first.md

# piped stdin appends to the same note
env BD_VAULT=$WORK/vault
stdin dump.txt
exec bd --daily
cmp vault/Daily/2026-10-10.md want-second.md

# empty input is an error and writes nothing new
! exec bd --daily
stderr 'nothing to capture'

# no vault anywhere is an error
env BD_VAULT=
! exec bd --daily hello
stderr 'no vault configured'

-- dump.txt --
second thought
from a pipe
-- want-first.md --
## 2026-10-10 14:32
kafka retries need backoff
-- want-second.md --
## 2026-10-10 14:32
kafka retries need backoff

## 2026-10-10 14:32
second thought
from a pipe
