# setting the vault writes it to the config file
env XDG_CONFIG_HOME=$WORK/cfg
mkdir vault
exec bd config set vault $WORK/vault
stdout 'vault set to .*vault'
! stdout 'created'
grep '"vault": ".*vault"' cfg/bd/config.json

# a missing directory (and its parents) is created
exec bd config set vault $WORK/new/nested/vault
stdout 'created .*new/nested/vault'
stdout 'vault set to .*new/nested/vault'
exists new/nested/vault
grep '"vault": ".*new/nested/vault"' cfg/bd/config.json

# ~ is expanded before creating, not made as a literal "~" dir
env HOME=$WORK/home
exec bd config set vault ~/notes
exists home/notes
! exists '~'

# a path that is a file is still rejected
! exec bd config set vault $WORK/afile.md
stderr 'not a directory'

# unknown keys are rejected
! exec bd config set colour blue
stderr 'unknown config key'

-- afile.md --
not a dir
