# The fake fzf records its args and candidates, then replies with FAKE_OUT / FAKE_EXIT.
env BD_NOW=2026-10-10T14:32:00Z
env BD_VAULT=$WORK/vault
env XDG_CONFIG_HOME=$WORK/cfg
env BD_FZF=$WORK/fakefzf
env BD_INTERACTIVE=1
chmod 755 fakefzf

# daily note is offered first, then notes; dotdirs are hidden
env FAKE_OUT='kaf\nProjects/Kafka.md\tProjects/Kafka\n'
env FAKE_EXIT=0
exec bd retries need backoff
stdout 'added to Projects/Kafka.md'
cmp vault/Projects/Kafka.md want-kafka.md
grep -count=1 '^Daily/2026-10-10.md	📅 Today' candidates.txt
grep '^Projects/Kafka.md	Projects/Kafka$' candidates.txt
! grep obsidian candidates.txt
grep 'print-query' args.txt

# typing a name that matches nothing creates a new note
env FAKE_OUT='Ideas/Rust CLI\n'
env FAKE_EXIT=1
exec bd build it in go
stdout 'created Ideas/Rust CLI.md'
exists 'vault/Ideas/Rust CLI.md'

# esc never loses the dump: it goes to the daily note
env FAKE_OUT='half typed\n'
env FAKE_EXIT=130
exec bd do not lose me
stdout 'added to Daily/2026-10-10.md'
grep 'do not lose me' vault/Daily/2026-10-10.md

# a name outside the vault is refused but the dump is still kept in daily
env FAKE_OUT='../escape\n'
env FAKE_EXIT=1
exec bd sneaky
stderr 'inside the vault'
stdout 'added to Daily/2026-10-10.md'
grep sneaky vault/Daily/2026-10-10.md
! exists escape.md

# --daily skips the picker
rm args.txt
exec bd --daily straight in
! exists args.txt

# non-interactive skips the picker
env BD_INTERACTIVE=
exec bd scripted
! exists args.txt
grep scripted vault/Daily/2026-10-10.md

-- fakefzf --
#!/bin/sh
cat > "$WORK/candidates.txt"
echo "$@" > "$WORK/args.txt"
printf "$FAKE_OUT"
exit "$FAKE_EXIT"
-- vault/Projects/Kafka.md --
# Kafka
-- vault/.obsidian/hidden.md --
nope
-- want-kafka.md --
# Kafka

## 2026-10-10 14:32
retries need backoff
